{
  "name": "eslint-plugin-no-excess-properties",
  "description": "Excess properties are not allowed on object literals",
  "license": "MIT",
  "version": "0.1.3",
  "homepage": "https://github.com/unimorphic/eslint-plugin-no-excess-properties",
  "keywords": [
    "eslint-plugin",
    "eslint",
    "eslintplugin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unimorphic/eslint-plugin-no-excess-properties.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "pack": "pnpm run build && pnpm pack",
    "prepare": "pnpm run build",
    "test": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.71.1",
    "ts-api-utils": "2.5.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8.0.0",
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/rule-tester": "8.71.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
