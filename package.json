{
  "name": "eslint-plugin-no-excess-properties",
  "description": "Excess properties are not allowed on object literals",
  "license": "MIT",
  "version": "0.1.3",
  "homepage": "https://github.com/unimorphic/eslint-plugin-no-excess-properties",
  "keywords": [
    "eslint-plugin",
    "eslint",
    "eslintplugin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unimorphic/eslint-plugin-no-excess-properties.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.58.0",
    "ts-api-utils": "2.5.0"
  },
  "peerDependencies": {
    "@eslint/js": ">=9.0.0",
    "@typescript-eslint/parser": ">=8.0.0",
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@typescript-eslint/rule-tester": "8.58.0",
    "eslint-plugin-eslint-plugin": "7.3.2",
    "prettier": "3.8.1",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.2"
  }
}
